# BrutalCheapFlights Configuration
# ==================================
# 3 APIs configured with automatic fallback:
#   1. Google Flights (150 req/month, free via RapidAPI)
#   2. Sky-Scrapper   (100 req/month, free via RapidAPI)
#   3. FlightAPI.io   (10 searches, free)

# ─── API 1 & 2: RapidAPI Key (shared for Google Flights + Sky-Scrapper) ───
# Subscribe free: https://rapidapi.com/DataCrawler/api/google-flights2
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── API 3: FlightAPI.io ── 20 credits (10 searches) ───
FLIGHTAPI_KEY=your_flightapi_key_here

# ─── Aviationstack — Real-time flight tracking ───
# Sign up free: https://aviationstack.com/
AVIATIONSTACK_KEY=your_aviationstack_key_here

# Server port
PORT=3000
